# Copy to .env locally. Never commit real secrets. All values here are placeholders.
TRUSTFLOW_ENV=dev
# fake = deterministic offline (default). live = Meta Model API (requires MODEL_API_KEY).
TRUSTFLOW_LLM_MODE=fake
MODEL_API_KEY=
TRUSTFLOW_LLM_BASE_URL=https://api.meta.ai/v1
TRUSTFLOW_PLANNING_MODEL=muse-wonder-1.0
TRUSTFLOW_REVIEW_MODEL=muse-wonder-1.0
TRUSTFLOW_FAST_MODEL=muse-spark-1.3
TRUSTFLOW_LLM_TIMEOUT_SECONDS=30
TRUSTFLOW_LLM_MAX_RETRIES=2
TRUSTFLOW_TOKEN_BUDGET_PER_WORKFLOW=20000
TRUSTFLOW_HIGH_RISK_THRESHOLD=1000
TRUSTFLOW_MAX_STEPS=20
TRUSTFLOW_MAX_RETRIES=2
TRUSTFLOW_STEP_TIMEOUT_SECONDS=5
